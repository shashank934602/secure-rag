# Copy to .env and fill in. Never commit .env.

# Main chat LLM (Phase 1+)
GROQ_API_KEY=

# Optional: OpenAI models (not required since ADR-0005)
OPENAI_API_KEY=

# Reranker / injection classifier downloads (Phase 3+)
HUGGINGFACEHUB_ACCESS_TOKEN=

# Embeddings (mistral-embed) and the alternate chat model — required
MISTRAL_API_KEY=

# Alternate provider (optional)
GOOGLE_API_KEY=

# Optional overrides (defaults in app/config.py)
# CHAT_MODEL=groq:openai/gpt-oss-120b
# EMBEDDING_MODEL=mistralai:mistral-embed
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# TOP_K=5

# Phase 2 database: local Docker Postgres on 127.0.0.1:5433 (docker-compose.yml).
# Generate the two passwords yourself, e.g. python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=
# Admin: used only to run migrations
DATABASE_ADMIN_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/rag
# The app's role, rag_app; its password is set from here by the first migration
DATABASE_URL=postgresql://rag_app:<app password>@127.0.0.1:5433/rag
