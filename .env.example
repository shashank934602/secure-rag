# Easiest: python3 scripts/make_env.py (generates every local secret; you paste the two API keys).
# Or copy to .env and fill in. Never commit .env.

# Main chat LLM (Phase 1+)
GROQ_API_KEY=

# Optional: OpenAI models (not required since ADR-0005)
OPENAI_API_KEY=

# Reranker / injection classifier downloads (Phase 3+)
HUGGINGFACEHUB_ACCESS_TOKEN=

# Embeddings (mistral-embed) and the alternate chat model — required
MISTRAL_API_KEY=

# Alternate provider (optional)
GOOGLE_API_KEY=

# Optional overrides (defaults in app/config.py)
# CHAT_MODEL=groq:openai/gpt-oss-120b
# EMBEDDING_MODEL=mistralai:mistral-embed
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# TOP_K=5

# Phase 2 database: local Docker Postgres on 127.0.0.1:5433 (docker-compose.yml).
# Generate the two passwords yourself, e.g. python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=
# Admin: used only to run migrations
DATABASE_ADMIN_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5433/rag
# The app's role, rag_app; its password is set from here by the first migration
DATABASE_URL=postgresql://rag_app:<app password>@127.0.0.1:5433/rag
# The same rag_app password on its own: docker compose builds the in-network URL from it (Phase 8)
RAG_APP_PASSWORD=

# Access tokens are RS256 (spec 09): the private key signs, the public key checks. Base64 of each
# PEM, one line each; scripts/make_env.py generates the pair with openssl.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# During a key rotation only: the previous public key, so tokens it signed still pass for 15 minutes
JWT_PREVIOUS_PUBLIC_KEY=

# Limits (spec 09; defaults in app/config.py). docker compose sets REDIS_URL for the API itself;
# without it (plain uvicorn) the counters live in that one process.
# REDIS_URL=redis://127.0.0.1:6379/0
# RATE_LIMIT_USER_PER_MIN=20
# RATE_LIMIT_TENANT_PER_MIN=120
# TENANT_DAILY_TOKEN_BUDGET=200000
# TOKEN_TTL_S=900

# Phase 6: keyed hash of questions in the audit log. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=
