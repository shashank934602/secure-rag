# Copy to .env and fill in. Never commit .env.

# Main chat LLM (Phase 1+)
GROQ_API_KEY=

# Embeddings: text-embedding-3-small (Phase 1+)
OPENAI_API_KEY=

# Reranker / injection classifier downloads (Phase 3+)
HUGGINGFACEHUB_ACCESS_TOKEN=

# Alternate providers, to prove models are swappable (optional)
GOOGLE_API_KEY=
MISTRAL_API_KEY=

